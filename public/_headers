/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800

# Cache the HTML at the CF edge for ~1 day; stale-while-revalidate keeps it
# instant for everyone while a single deploy bumps the source-of-truth.
# psi-swarm flagged TTFB ~370ms as the dominant LCP contributor.
#
# IMPORTANT: CF Pages was returning cf-cache-status: DYNAMIC with just
# s-maxage. Adding an explicit max-age (browser cache) seems to be the
# tell CF Pages needs to mark HTML responses as cacheable at edge too.
/
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800

/*.html
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800
