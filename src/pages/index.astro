---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeader from '@/components/astro/SectionHeader.astro';
import WorkCard from '@/components/astro/WorkCard.astro';
import { site } from '@/data/site';
import { spotlightProducts } from '@/data/spotlight-products';

const work = (await getCollection('work'))
  .filter((w) => w.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={site.name}>
  {/* ----------------------------------------------------------------- */}
  {/* Hero                                                              */}
  {/* ----------------------------------------------------------------- */}
  <section class="relative overflow-hidden border-b border-line">
    <div class="grid-bg pointer-events-none absolute inset-0 opacity-60"></div>

    <div class="relative mx-auto max-w-4xl px-5 py-20 sm:px-8 sm:py-28 lg:py-36">
      <div class="max-w-3xl">
        {
          site.availability && (
            <div class="inline-flex items-center gap-2 rounded-full border border-line bg-panel px-3 py-1 font-mono text-xs text-muted">
              <span class="relative flex h-2 w-2">
                <span
                  class="absolute inline-flex h-full w-full rounded-full bg-accent"
                  style="animation: pulse-ring 2.4s var(--ease-out-expo) infinite;"
                />
                <span class="inline-flex h-2 w-2 rounded-full bg-accent" />
              </span>
              {site.availability}
            </div>
          )
        }

        <h1
          class="mt-6 text-balance text-4xl font-semibold leading-[1.05] tracking-tight text-fg sm:text-5xl lg:text-6xl"
        >
          I build dependable <span class="text-accent">AI products</span>, from
          infrastructure to interface.
        </h1>

        <p class="mt-6 max-w-xl text-pretty text-base leading-relaxed text-muted sm:text-lg">
          I'm {site.name}, an AI infrastructure and product engineer. I turn
          model capabilities into systems people can trust: local code review,
          post-training tools, private assistants, research signals, and the
          operating layer behind them.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a
            href="#focus"
            class="rounded-md bg-accent px-4 py-2.5 text-sm font-medium text-base transition-opacity hover:opacity-90"
          >
            See what I’m building
          </a>
          <a
            href="#work"
            class="link-underline font-mono text-xs text-muted transition-colors hover:text-fg"
          >
            production case studies →
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ----------------------------------------------------------------- */}
  {/* Current focus                                                     */}
  {/* ----------------------------------------------------------------- */}
  <section id="focus" class="scroll-mt-20 border-y border-line bg-panel/40">
    <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
      <SectionHeader
        kicker="// current focus"
        title="Four products, one platform."
        intro="Four focused products — CodeVetter, Post-train LLM, HeyPace, and HiSignal — with SaaS Maker as the directory and operating layer for everything else."
      />
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          spotlightProducts.map((project) => (
            <a
              href={project.url}
              target="_blank"
              rel="noopener noreferrer"
              class="panel panel-hover group flex flex-col p-5"
            >
              <h2 class="font-semibold text-fg transition-colors group-hover:text-accent">
                {project.label}
              </h2>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">
                {project.description}
              </p>
              <span class="mt-5 border-t border-line pt-3 font-mono text-xs text-accent">
                {project.id === 'saas-maker' ? 'open the directory →' : 'view product →'}
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* ----------------------------------------------------------------- */}
  {/* Selected work                                                     */}
  {/* ----------------------------------------------------------------- */}
  <section id="work" class="scroll-mt-20">
    <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
      <SectionHeader
        kicker="// selected work"
        title="A few things I've built."
        intro="Four projects from my day jobs — what the problem was, what I built, and what changed."
      />
      {
        work.length > 0 ? (
          <div class="mt-10 grid gap-5 sm:grid-cols-2">
            {work.map((entry, i) => (
              <WorkCard entry={entry} index={i} />
            ))}
          </div>
        ) : (
          <p class="mt-10 font-mono text-sm text-faint">
            Case studies coming soon.
          </p>
        )
      }
    </div>
  </section>

</BaseLayout>
