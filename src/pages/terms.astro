---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/data/site';
---

<BaseLayout
  title="Terms"
  description={`Terms of use for ${site.url} — personal portfolio and writing by ${site.name}.`}
>
  <article class="mx-auto max-w-2xl px-5 py-16 sm:px-8 sm:py-20">
    <a
      href="/"
      class="link-underline font-mono text-sm text-muted transition-colors hover:text-accent"
    >
      ← home
    </a>

    <header class="mt-8 border-b border-line pb-8">
      <h1 class="text-3xl font-semibold tracking-tight text-fg sm:text-4xl">
        Terms of Use
      </h1>
      <p class="mt-3 font-mono text-xs text-faint">Last updated: June 10, 2026</p>
    </header>

    <div class="prose mt-8">
      <h2>Use of this site</h2>
      <p>
        Content on {site.url} is provided for informational purposes. You may
        link to public pages with attribution. Do not scrape or republish full
        articles without permission.
      </p>

      <h2>No warranties</h2>
      <p>
        Portfolio work, blog posts, and linked open-source projects are provided
        as-is. I make no guarantees about availability, accuracy, or fitness for
        a particular purpose.
      </p>

      <h2>Linked products</h2>
      <p>
        Shipped products listed on <a href="/projects">/projects</a> are operated
        separately. Their terms and privacy policies apply on their own domains.
      </p>

      <h2>Contact</h2>
      <p>
        Questions: <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>
  </article>
</BaseLayout>
