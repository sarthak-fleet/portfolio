---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — Not found"
  description="That route doesn't exist."
  hideFooter
>
  <section
    class="relative mx-auto flex min-h-[78vh] max-w-2xl flex-col items-start justify-center px-5 sm:px-8"
  >
    <div class="grid-bg pointer-events-none absolute inset-0 opacity-40"></div>

    <div class="relative w-full">
      <p class="kicker">// 404</p>
      <h1
        class="mt-3 font-mono text-7xl font-semibold tracking-tighter text-fg sm:text-8xl"
      >
        404
      </h1>

      <div class="panel mt-8 overflow-hidden font-mono text-[13px]">
        <div
          class="flex items-center gap-2 border-b border-line bg-panel-2 px-3.5 py-2.5"
        >
          <span class="chrome-dot bg-[#ff5f57]"></span>
          <span class="chrome-dot bg-[#febc2e]"></span>
          <span class="chrome-dot bg-[#28c840]"></span>
        </div>
        <div class="space-y-1 px-4 py-4 leading-relaxed">
          <p>
            <span class="text-accent">guest@sarthak</span><span
              class="text-faint">:~$</span
            > cat {Astro.url.pathname}
          </p>
          <p class="text-[#f5736b]">
            error: no such route — the request returned 404
          </p>
          <p class="text-faint">↳ the page moved, never existed, or was a typo</p>
        </div>
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href="/"
          class="rounded-md bg-accent px-4 py-2.5 text-sm font-medium text-base transition-opacity hover:opacity-90"
        >
          ← Back home
        </a>
        <button
          type="button"
          data-cmdk-trigger
          class="rounded-md border border-line-strong px-4 py-2.5 font-mono text-sm text-fg transition-colors hover:border-faint hover:bg-panel"
        >
          ⌘K to navigate
        </button>
      </div>
    </div>
  </section>
</BaseLayout>
