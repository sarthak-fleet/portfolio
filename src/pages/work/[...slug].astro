---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const work = (await getCollection('work')).sort(
    (a, b) => a.data.order - b.data.order
  );
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: work[i - 1] ?? null,
      next: work[i + 1] ?? null,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const { data } = entry;
const toc = headings.filter((h) => h.depth === 2);
---

<BaseLayout title={data.title} description={data.summary} type="article">
  <article class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
    <a
      href="/#work"
      class="link-underline font-mono text-sm text-muted transition-colors hover:text-accent"
    >
      ← selected work
    </a>

    <!-- Header -->
    <header class="mt-8 border-b border-line pb-10">
      <p class="font-mono text-xs text-accent">{data.tagline}</p>
      <h1
        class="mt-3 text-balance text-4xl font-semibold tracking-tight text-fg sm:text-5xl"
      >
        {data.title}
      </h1>
      <p class="mt-4 max-w-2xl text-pretty text-lg leading-relaxed text-muted">
        {data.summary}
      </p>

      <div
        class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 font-mono text-xs text-faint"
      >
        <span>{data.role}</span>
        <span class="text-line-strong">/</span>
        <span>{data.year}</span>
        {data.repo && (
            <>
              <span class="text-line-strong">/</span>
              <a
                href={data.repo}
                target="_blank"
                rel="noopener noreferrer"
                class="text-accent link-underline"
              >
                source ↗
              </a>
            </>
          )}
        {data.demo && (
            <>
              <span class="text-line-strong">/</span>
              <a
                href={data.demo}
                target="_blank"
                rel="noopener noreferrer"
                class="text-accent link-underline"
              >
                live demo ↗
              </a>
            </>
          )}
      </div>

      {data.metrics.length > 0 && (
          <div class="mt-8 flex flex-wrap gap-x-10 gap-y-4">
            {data.metrics.map((m) => (
              <div>
                <div class="font-mono text-2xl font-semibold text-fg">
                  {m.value}
                </div>
                <div class="font-mono text-[11px] tracking-wide text-faint">
                  {m.label}
                </div>
              </div>
            ))}
          </div>
        )}
    </header>

    <!-- Body + sticky sidebar -->
    <div class="mt-10 grid gap-12 lg:grid-cols-[1fr_220px] lg:gap-14">
      <div class="prose min-w-0 max-w-2xl">
        <Content />
      </div>

      <aside class="hidden lg:block">
        <div class="sticky top-24 space-y-8">
          {toc.length > 0 && (
              <nav aria-label="On this page">
                <p class="kicker mb-3">// contents</p>
                <ul class="space-y-2">
                  {toc.map((h) => (
                    <li>
                      <a
                        href={`#${h.slug}`}
                        data-toc-link
                        class="block border-l border-line py-0.5 pl-3 text-sm text-faint transition-colors hover:text-fg data-[active]:border-accent data-[active]:text-accent"
                      >
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            )}

          <div>
            <p class="kicker mb-3">// stack</p>
            <ul class="flex flex-wrap gap-1.5">
              {data.stack.map((tech) => (
                  <li class="rounded border border-line bg-panel-2 px-1.5 py-0.5 font-mono text-[11px] text-muted">
                    {tech}
                  </li>
                ))}
            </ul>
          </div>
        </div>
      </aside>
    </div>

    <!-- Prev / next -->
    <nav
      class="mt-16 grid gap-4 border-t border-line pt-8 sm:grid-cols-2"
      aria-label="More work"
    >
      {prev ? (
          <a
            href={`/work/${prev.id}`}
            class="panel panel-hover group p-5"
          >
            <span class="font-mono text-xs text-faint">← previous</span>
            <div class="mt-1 font-medium text-fg transition-colors group-hover:text-accent">
              {prev.data.title}
            </div>
          </a>
        ) : (
          <span />
        )}
      {next && (
          <a
            href={`/work/${next.id}`}
            class="panel panel-hover group p-5 sm:text-right"
          >
            <span class="font-mono text-xs text-faint">next →</span>
            <div class="mt-1 font-medium text-fg transition-colors group-hover:text-accent">
              {next.data.title}
            </div>
          </a>
        )}
    </nav>
  </article>
</BaseLayout>

<script>
  const setupToc = () => {
    const links =
      document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
    if (!links.length) return;
    const byId = new Map<string, HTMLAnchorElement>();
    links.forEach((l) => {
      const id = l.getAttribute('href')?.slice(1);
      if (id) byId.set(id, l);
    });
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            links.forEach((l) => l.removeAttribute('data-active'));
            byId.get(e.target.id)?.setAttribute('data-active', 'true');
          }
        });
      },
      { rootMargin: '-10% 0px -75% 0px' }
    );
    document
      .querySelectorAll('.prose h2[id]')
      .forEach((h) => observer.observe(h));
  };

  document.addEventListener('astro:page-load', setupToc);
</script>
