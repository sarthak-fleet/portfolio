---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeader from '@/components/astro/SectionHeader.astro';
import RepoCard from '@/components/astro/RepoCard.astro';
import { getProjectGroups, getRepos } from '@/lib/github';
import { site } from '@/data/site';
import { fleetProductGroups, fleetProjectCount } from '@/data/fleet-products';
import { rootDomains } from '@/data/root-domains';

const groups = await getProjectGroups();
const allRepos = await getRepos();
const curatedCount = groups.reduce((n, g) => n + g.repos.length, 0);
const totalCount = allRepos.length;
const rest = Math.max(totalCount - curatedCount, 0);
const bucketSummary = fleetProductGroups
  .map((group) => `${group.products.length} ${group.label.toLowerCase()}`)
  .join(' / ');
---

<BaseLayout
  title="Projects"
  description={`Ten root domains and open-source projects by ${site.name} — CodeVetter, PostTrainLLM, Pace, and the rest of the fleet.`}
>
  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
    <SectionHeader
      kicker="// fleet"
      title="The product fleet."
      intro={`The landing page stays precise with three products plus SaaS Maker. This is the full archive: ${bucketSummary}, ${fleetProjectCount} active entries total. For the canonical directory and product pages, visit SaaS Maker.`}
    />

    <div
      class="panel mt-8 flex flex-col items-start gap-3 p-5 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="max-w-2xl text-sm leading-relaxed text-muted">
        SaaS Maker is the broader directory for the fleet — product pages,
        supporting tools, and the operating layer behind them.
      </p>
      <a
        href="https://sassmaker.com"
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 rounded-md bg-accent px-4 py-2.5 text-sm font-medium text-base transition-opacity hover:opacity-90"
      >
        Open SaaS Maker →
      </a>
    </div>

    <div class="mt-14">
      <SectionHeader
        kicker="// ten root domains"
        title="Canonical roots."
        intro="Every root brand that should own search for its name. P0 products get active visibility work first."
      />
      <ul class="mt-10 grid gap-3 sm:grid-cols-2">
        {rootDomains.map((root) => (
          <li>
            <a
              href={root.url}
              target="_blank"
              rel="noopener noreferrer"
              class="panel panel-hover group flex flex-col p-5 no-underline"
            >
              <div class="flex items-start justify-between gap-3">
                <h2 class="font-semibold text-fg transition-colors group-hover:text-accent">{root.name}</h2>
                <span class="shrink-0 rounded border border-line bg-panel-2 px-1.5 py-0.5 font-mono text-[11px] uppercase text-faint">
                  {root.tier}
                </span>
              </div>
              <p class="mt-1 font-mono text-xs text-accent">{root.domain}</p>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{root.blurb}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>

    {fleetProductGroups.map((group) => (
        <div class="mt-14 first:mt-10">
          <SectionHeader
            kicker={group.kicker}
            title={group.label}
            intro={group.intro}
          />

          <div class="mt-10 grid gap-4 sm:grid-cols-2">
            {group.products.map((product) => (
              <a
                href={product.url}
                target="_blank"
                rel="noopener noreferrer"
                class="panel panel-hover group flex flex-col p-5"
              >
                <div class="flex items-start justify-between gap-3">
                  <h2 class="font-semibold text-fg transition-colors group-hover:text-accent">
                    {product.name}
                  </h2>
                  <span class="shrink-0 rounded border border-line bg-panel-2 px-1.5 py-0.5 font-mono text-[11px] text-faint">
                    {product.maturity.replace('-', ' ')}
                  </span>
                </div>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{product.description}</p>
                <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1.5 border-t border-line pt-3 font-mono text-[11px] text-faint">
                  <span class="text-accent">
                    {product.url.replace(/^https:\/\//, '').replace(/^https:\/\/github\.com\//, 'github.com/')}
                  </span>
                  {product.repo && product.repo !== product.url && (
                    <span>{product.repo.replace(/^https:\/\/github\.com\//, 'github.com/')}</span>
                  )}
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}

    <div class="mt-16">
      <SectionHeader
        kicker="// open source"
        title="The work worth your time."
        intro={`I've got ${totalCount} public repos. Most are experiments or learning projects, so instead of dumping the lot, here are the ones worth a look — picked by reading the code, not the README.`}
      />
    </div>

    {groups.length > 0 ? (
        <>
          {groups.map((group) => (
            <div class="mt-14 first:mt-12">
              <div class="flex items-baseline gap-3">
                <h2 class="kicker">// {group.label}</h2>
                <span class="font-mono text-xs text-faint">
                  {group.repos.length}
                </span>
              </div>
              <p class="mt-2 max-w-xl text-sm text-muted">{group.intro}</p>
              <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                {group.repos.map((repo) => (
                  <RepoCard repo={repo} />
                ))}
              </div>
            </div>
          ))}

          <div class="panel mt-14 flex flex-col items-start gap-4 p-6 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <p class="font-medium text-fg">That's the good stuff.</p>
              <p class="mt-1 text-sm text-muted">
                {rest > 0 ? `Another ${rest}+ repos` : 'The rest'} — experiments,
                half-built ideas and old contest solutions — are on GitHub if you
                feel like digging.
              </p>
            </div>
            <a
              href={`https://github.com/${site.githubUser}?tab=repositories`}
              target="_blank"
              rel="noopener noreferrer"
              class="shrink-0 rounded-md border border-line-strong px-4 py-2.5 text-sm font-medium text-fg transition-colors hover:border-faint hover:bg-panel-2"
            >
              Browse all on GitHub →
            </a>
          </div>
        </>
      ) : (
        <div class="panel mt-10 p-8 text-center">
          <p class="text-muted">
            The live project list couldn't be fetched at build time.
          </p>
          <a
            href={`https://github.com/${site.githubUser}?tab=repositories`}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-block font-mono text-sm text-accent link-underline"
          >
            Browse everything on GitHub →
          </a>
        </div>
      )}
  </section>
</BaseLayout>
