---
/**
 * Animated distributed-system diagram — the site's signature visual.
 * Pure inline SVG + CSS (the `flow` keyframe). Ships zero JavaScript and
 * fully respects prefers-reduced-motion (the global media query freezes it).
 */

type Kind = 'edge' | 'compute' | 'data';

interface Node {
  id: string;
  cx: number;
  cy: number;
  label: string;
  tag: string;
  kind: Kind;
}

const W = 120; // node width
const H = 54; // node height
const PORT = 60; // half-width, where edges attach

const nodes: Node[] = [
  { id: 'clients', cx: 72, cy: 212, label: 'Clients', tag: 'web · mobile', kind: 'edge' },
  { id: 'edge', cx: 234, cy: 212, label: 'Edge / CDN', tag: 'cloudflare', kind: 'edge' },
  { id: 'api', cx: 400, cy: 212, label: 'API Gateway', tag: 'auth · routing', kind: 'compute' },
  { id: 'queue', cx: 582, cy: 96, label: 'Kafka', tag: 'event stream', kind: 'data' },
  { id: 'llm', cx: 582, cy: 212, label: 'Vector Search', tag: 'milvus · embeddings', kind: 'compute' },
  { id: 'db', cx: 582, cy: 328, label: 'MySQL', tag: 'primary store', kind: 'data' },
  { id: 'workers', cx: 744, cy: 96, label: 'Workers', tag: 'go services', kind: 'compute' },
  { id: 'cache', cx: 744, cy: 270, label: 'Redis', tag: 'cache · realtime', kind: 'data' },
];

const edges: [string, string][] = [
  ['clients', 'edge'],
  ['edge', 'api'],
  ['api', 'queue'],
  ['api', 'llm'],
  ['api', 'db'],
  ['queue', 'workers'],
  ['llm', 'cache'],
  ['workers', 'db'],
  ['workers', 'cache'],
];

const byId = Object.fromEntries(nodes.map((n) => [n.id, n]));

function path(aId: string, bId: string) {
  const a = byId[aId];
  const b = byId[bId];
  const x1 = a.cx + PORT;
  const y1 = a.cy;
  const x2 = b.cx - PORT;
  const y2 = b.cy;
  const mx = (x1 + x2) / 2;
  return { d: `M ${x1} ${y1} C ${mx} ${y1}, ${mx} ${y2}, ${x2} ${y2}`, x1, y1, x2, y2 };
}

const dotColor: Record<Kind, string> = {
  edge: 'var(--color-faint)',
  compute: 'var(--color-accent)',
  data: 'var(--color-warn)',
};
---

<div class="panel overflow-hidden">
  <div
    class="flex items-center justify-between border-b border-line bg-panel-2 px-4 py-2.5 font-mono text-xs text-faint"
  >
    <span>~/architecture — request lifecycle</span>
    <span class="hidden items-center gap-1.5 sm:flex">
      <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
      live data flow
    </span>
  </div>

  <div class="overflow-x-auto">
    <svg
      viewBox="0 0 820 410"
      class="block min-w-[680px]"
      role="img"
      aria-label="A distributed system: clients reach an edge/CDN, then an API gateway, which fans out to a job queue, LLM serving, and a Postgres database; workers and a Redis cache complete the topology."
    >
      <!-- edges -->
      {
        edges.map(([from, to], i) => {
          const p = path(from, to);
          return (
            <g>
              <path d={p.d} fill="none" stroke="var(--color-line-strong)" stroke-width="1.5" />
              <path
                d={p.d}
                fill="none"
                stroke="var(--color-accent)"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-dasharray="3 9"
                opacity="0.85"
                style={`animation: var(--animate-flow); animation-delay: -${i * 0.26}s;`}
              />
              <circle cx={p.x2} cy={p.y2} r="2.6" fill="var(--color-accent)" />
            </g>
          );
        })
      }

      <!-- nodes -->
      {
        nodes.map((n) => (
          <g class="arch-node" style={`transform-origin: ${n.cx}px ${n.cy}px;`}>
            <rect
              x={n.cx - W / 2}
              y={n.cy - H / 2}
              width={W}
              height={H}
              rx="9"
              fill="var(--color-panel-2)"
              stroke="var(--color-line-strong)"
              stroke-width="1"
            />
            <circle cx={n.cx - W / 2 + 13} cy={n.cy - H / 2 + 13} r="3" fill={dotColor[n.kind]} />
            <text
              x={n.cx}
              y={n.cy - 2}
              text-anchor="middle"
              fill="var(--color-fg)"
              font-family="var(--font-mono)"
              font-size="12.5"
              font-weight="500"
            >
              {n.label}
            </text>
            <text
              x={n.cx}
              y={n.cy + 14}
              text-anchor="middle"
              fill="var(--color-faint)"
              font-family="var(--font-mono)"
              font-size="8.5"
              letter-spacing="0.04em"
            >
              {n.tag}
            </text>
          </g>
        ))
      }
    </svg>
  </div>

  <div
    class="flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-line px-4 py-3 font-mono text-[11px] text-faint"
  >
    <span class="flex items-center gap-1.5">
      <span class="h-2 w-2 rounded-full bg-faint"></span>ingress
    </span>
    <span class="flex items-center gap-1.5">
      <span class="h-2 w-2 rounded-full bg-accent"></span>compute
    </span>
    <span class="flex items-center gap-1.5">
      <span class="h-2 w-2 rounded-full bg-warn"></span>stateful
    </span>
    <span class="ml-auto hidden sm:block">built to keep working when something downstream doesn't</span>
  </div>
</div>

<style>
  .arch-node {
    transition: transform 0.3s var(--ease-out-expo);
  }
  .arch-node:hover {
    transform: scale(1.04);
  }
  .arch-node rect {
    transition: stroke 0.2s ease;
  }
  .arch-node:hover rect {
    stroke: var(--color-accent);
  }
</style>
