---
import type { Repo } from '@/lib/github';
import { langColor } from '@/lib/github';

interface Props {
  repo: Repo;
  compact?: boolean;
}

const { repo, compact = false } = Astro.props;
const color = (repo.language && langColor[repo.language]) || '#585c64';

const prettyName = repo.name.replace(/[-_]/g, ' ');
const updated = repo.updated
  ? new Intl.DateTimeFormat('en', { month: 'short', year: 'numeric' }).format(
      new Date(repo.updated)
    )
  : null;

const StarIcon =
  'M12 2.5l2.95 5.98 6.6.96-4.77 4.65 1.13 6.57L12 18.56l-5.9 3.1 1.12-6.57L2.45 9.44l6.6-.96z';
---

{compact ? (
    <a
      href={repo.url}
      target="_blank"
      rel="noopener noreferrer"
      class="panel panel-hover group flex items-center gap-3 p-3.5"
    >
      <span
        class="h-2.5 w-2.5 shrink-0 rounded-full"
        style={`background:${color}`}
        title={repo.language ?? 'Other'}
      />
      <span class="min-w-0 flex-1">
        <span class="block truncate font-mono text-sm text-fg transition-colors group-hover:text-accent">
          {repo.name}
        </span>
        {repo.description && (
          <span class="block truncate text-xs text-faint">
            {repo.description}
          </span>
        )}
      </span>
      {repo.stars > 0 && (
        <span class="flex shrink-0 items-center gap-1 font-mono text-xs text-faint">
          <svg viewBox="0 0 24 24" class="h-3 w-3 fill-faint">
            <path d={StarIcon} />
          </svg>
          {repo.stars}
        </span>
      )}
    </a>
  ) : (
    <a
      href={repo.url}
      target="_blank"
      rel="noopener noreferrer"
      class="panel panel-hover group flex flex-col p-5"
    >
      <div class="flex items-start justify-between gap-3">
        <h3 class="flex items-center gap-2 font-mono text-sm font-medium text-fg transition-colors group-hover:text-accent">
          <svg
            viewBox="0 0 24 24"
            class="h-4 w-4 shrink-0 text-faint"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M3 6a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v15l-4-3-4 3V4" />
          </svg>
          <span class="capitalize">{prettyName}</span>
        </h3>
        {repo.stars > 0 && (
          <span class="flex shrink-0 items-center gap-1 rounded border border-line bg-panel-2 px-1.5 py-0.5 font-mono text-[11px] text-muted">
            <svg viewBox="0 0 24 24" class="h-3 w-3 fill-accent">
              <path d={StarIcon} />
            </svg>
            {repo.stars}
          </span>
        )}
      </div>

      <p class="mt-2.5 flex-1 text-sm leading-relaxed text-muted">
        {repo.description ?? 'No description.'}
      </p>

      <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1.5 border-t border-line pt-3 font-mono text-[11px] text-faint">
        {repo.language && (
          <span class="flex items-center gap-1.5">
            <span
              class="h-2.5 w-2.5 rounded-full"
              style={`background:${color}`}
            />
            {repo.language}
          </span>
        )}
        {repo.forks > 0 && <span>⑂ {repo.forks}</span>}
        {updated && <span class="ml-auto">updated {updated}</span>}
      </div>
    </a>
  )}
