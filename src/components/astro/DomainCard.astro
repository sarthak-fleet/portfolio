---
import type { Domain } from '@/data/expertise';

interface Props {
  domain: Domain;
}

const { domain } = Astro.props;
---

<article class="panel panel-hover group flex flex-col p-6 sm:p-7">
  <div class="flex items-baseline gap-3">
    <span class="font-mono text-xs text-accent">{domain.index}</span>
    <h3 class="text-lg font-semibold tracking-tight text-fg">
      {domain.title}
    </h3>
  </div>

  <p class="mt-3 text-sm leading-relaxed text-muted">{domain.blurb}</p>

  <ul class="mt-5 flex flex-wrap gap-1.5 border-t border-line pt-5">
    {
      domain.items.map((item) => (
        <li class="rounded border border-line bg-panel-2 px-2 py-1 font-mono text-[11px] text-muted transition-colors group-hover:border-line-strong">
          {item}
        </li>
      ))
    }
  </ul>
</article>
