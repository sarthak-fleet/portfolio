---
interface Props {
  kicker: string;
  title: string;
  intro?: string;
}

const { kicker, title, intro } = Astro.props;
---

<div class="max-w-2xl">
  <p class="kicker">{kicker}</p>
  <h2
    class="mt-3 text-balance text-3xl font-semibold tracking-tight text-fg sm:text-4xl"
  >
    {title}
  </h2>
  {intro && <p class="mt-4 text-pretty text-muted">{intro}</p>}
</div>
