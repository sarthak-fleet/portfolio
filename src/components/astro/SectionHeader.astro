---
interface Props {
  kicker: string;
  title: string;
  intro?: string;
  heading?: 'h1' | 'h2';
}

const { kicker, title, intro, heading = 'h2' } = Astro.props;
const HeadingTag = heading;
---

<div class="max-w-2xl">
  <p class="kicker">{kicker}</p>
  <HeadingTag
    class="mt-3 text-balance text-3xl font-semibold tracking-tight text-fg sm:text-4xl"
  >
    {title}
  </HeadingTag>
  {intro && <p class="mt-4 text-pretty text-muted">{intro}</p>}
</div>
