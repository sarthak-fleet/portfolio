---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
  index: number;
}

const { entry, index } = Astro.props;
const { title, tagline, summary, stack, metrics, year } = entry.data;
const num = String(index + 1).padStart(2, '0');
---

<a
  href={`/work/${entry.id}`}
  class="panel panel-hover group flex flex-col p-6 sm:p-7"
>
  <div class="flex items-center justify-between font-mono text-xs text-faint">
    <span class="text-accent">{num}</span>
    <span>{year}</span>
  </div>

  <h3
    class="mt-4 text-xl font-semibold tracking-tight text-fg transition-colors group-hover:text-accent"
  >
    {title}
  </h3>
  <p class="mt-1 font-mono text-xs text-accent">{tagline}</p>

  <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{summary}</p>

  {metrics.length > 0 && (
      <div class="mt-5 flex flex-wrap gap-x-6 gap-y-3 border-t border-line pt-4">
        {metrics.map((m) => (
          <div>
            <div class="font-mono text-base font-semibold text-fg">{m.value}</div>
            <div class="font-mono text-[10px] tracking-wide text-faint">{m.label}</div>
          </div>
        ))}
      </div>
    )}

  <div class="mt-5 flex flex-wrap items-center gap-1.5">
    {stack.slice(0, 5).map((tech) => (
        <span class="rounded border border-line bg-panel-2 px-1.5 py-0.5 font-mono text-[10px] text-muted">
          {tech}
        </span>
      ))}
    <span
      class="ml-auto font-mono text-xs text-faint transition-all group-hover:translate-x-0.5 group-hover:text-accent"
    >
      read case study →
    </span>
  </div>
</a>
