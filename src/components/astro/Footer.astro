---
import { site } from '@/data/site';
import { socials } from '@/data/socials';

const year = new Date().getFullYear();
const profiles = socials.filter((social) => social.label !== 'Email');
---

<footer id="contact" class="scroll-mt-20 border-t border-line">
  <div class="mx-auto max-w-6xl px-5 py-10 sm:px-8 sm:py-12">
    <div
      class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between"
    >
      <div>
        <p class="kicker">// contact</p>
        <a
          href={`mailto:${site.email}`}
          class="link-underline mt-2 inline-block font-mono text-sm text-fg transition-colors hover:text-accent sm:text-lg"
        >
          {site.email}
        </a>
      </div>

      <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Social profiles">
        {profiles.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-muted transition-colors hover:text-fg"
            >
              {social.label}
            </a>
          ))}
      </nav>
    </div>

    <p class="mt-8 border-t border-line pt-5 font-mono text-xs text-faint">
      © {year} {site.name}
    </p>
  </div>
</footer>
