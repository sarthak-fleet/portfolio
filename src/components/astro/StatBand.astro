---
interface Stat {
  value: string;
  label: string;
}

interface Props {
  stats: Stat[];
}

const { stats } = Astro.props;
---

<div class="panel grid grid-cols-2 divide-line sm:grid-cols-4 sm:divide-x">
  {
    stats.map((stat, i) => (
      <div
        class:list={[
          'px-5 py-7 sm:px-6',
          { 'border-t border-line sm:border-t-0': i >= 2 },
          { 'border-l border-line sm:border-l-0': i % 2 === 1 },
        ]}
      >
        <div class="font-mono text-3xl font-semibold tracking-tight text-fg sm:text-4xl">
          {stat.value}
        </div>
        <div class="mt-1.5 font-mono text-xs tracking-wide text-muted">
          {stat.label}
        </div>
      </div>
    ))
  }
</div>
