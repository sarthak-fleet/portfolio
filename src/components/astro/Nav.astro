---
import { navLinks, site } from '@/data/site';
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-line bg-base/75 backdrop-blur-xl"
>
  <nav
    class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 sm:px-8"
    aria-label="Primary"
  >
    <!-- Monogram -->
    <a
      href="/"
      class="group flex items-center gap-2.5"
      aria-label={`${site.name} — home`}
    >
      <svg viewBox="0 0 32 32" class="h-7 w-7" aria-hidden="true">
        <g
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          class="text-accent"
        >
          <line x1="9" y1="9.5" x2="9" y2="22.5"></line>
          <line x1="9" y1="9.5" x2="22.5" y2="16"></line>
          <line x1="9" y1="22.5" x2="22.5" y2="16"></line>
        </g>
        <g fill="currentColor" class="text-accent">
          <circle cx="9" cy="9.5" r="3"></circle>
          <circle cx="9" cy="22.5" r="3"></circle>
          <circle cx="22.5" cy="16" r="3.4"></circle>
        </g>
      </svg>
      <span
        class="font-mono text-sm font-medium tracking-tight text-fg transition-colors group-hover:text-accent"
      >
        {site.name}
      </span>
    </a>

    <!-- Center links -->
    <div class="hidden items-center gap-7 md:flex">
      {navLinks.map((link) => (
          <a
            href={link.href}
            class="link-underline text-sm text-muted transition-colors hover:text-fg"
          >
            {link.label}
          </a>
        ))}
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-2.5">
      <button
        type="button"
        data-theme-toggle
        class="pull-cord-toggle"
        aria-label="Pull cord to turn the lights on"
        aria-pressed="false"
        title="Turn lights on"
      >
        <span class="sr-only">Toggle light mode</span>
        <span class="pull-fixture" aria-hidden="true"></span>
        <span class="pull-chain" aria-hidden="true"></span>
        <span class="pull-bulb" aria-hidden="true"></span>
        <span class="pull-grip" aria-hidden="true"></span>
      </button>
      <a
        href={site.resumeUrl}
        class="hidden rounded-md border border-line px-3 py-1.5 text-sm text-muted transition-colors hover:border-line-strong hover:text-fg sm:block"
      >
        Resume
      </a>
      <button
        type="button"
        data-cmdk-trigger
        class="flex items-center gap-2 rounded-md border border-line bg-panel px-2.5 py-1.5 text-sm text-muted transition-colors hover:border-line-strong hover:text-fg"
        aria-label="Open command menu"
      >
        <svg
          viewBox="0 0 24 24"
          class="h-3.5 w-3.5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M3 5h18M3 12h18M3 19h18" stroke-linecap="round"></path>
        </svg>
        <kbd class="hidden font-mono text-xs sm:inline">⌘K</kbd>
      </button>
    </div>
  </nav>
</header>
