---
import { experience } from '@/data/experience';

interface Props {
  detailed?: boolean;
}

const { detailed = false } = Astro.props;
---

<ol>
  {experience.map((job, i) => {
      const notLast = i < experience.length - 1;
      return (
        <li class="relative grid grid-cols-[1.25rem_1fr] gap-x-4 pb-9 last:pb-0">
          <div class="relative flex justify-center pt-1.5">
            {job.current ? (
              <span class="relative z-10 flex h-3 w-3">
                <span
                  class="absolute inline-flex h-full w-full rounded-full bg-accent"
                  style="animation: pulse-ring 2.4s var(--ease-out-expo) infinite;"
                />
                <span class="inline-flex h-3 w-3 rounded-full border-2 border-accent bg-base" />
                <span class="absolute inset-[3px] rounded-full bg-accent" />
              </span>
            ) : (
              <span class="z-10 mt-px h-3 w-3 rounded-full border-2 border-line-strong bg-panel" />
            )}
            {notLast && (
              <span class="absolute bottom-[-2.25rem] top-4 w-px bg-line" />
            )}
          </div>

          <div>
            <p class="font-mono text-xs text-faint">{job.period}</p>
            <h3 class="mt-1 font-semibold tracking-tight text-fg">
              {job.role}
              <span class="text-muted"> · </span>
              {job.companyUrl ? (
                <a
                  href={job.companyUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-accent link-underline"
                >
                  {job.company}
                </a>
              ) : (
                <span class="text-accent">{job.company}</span>
              )}
              {job.tag && (
                <span class="ml-2 inline-block rounded border border-line bg-panel-2 px-1.5 py-0.5 align-middle font-mono text-[10px] font-normal text-faint">
                  {job.tag}
                </span>
              )}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{job.summary}</p>

            {detailed && (
              <>
                <ul class="mt-3 space-y-1.5">
                  {job.highlights.map((h) => (
                    <li class="flex gap-2.5 text-sm text-muted">
                      <span class="mt-2 h-px w-2.5 shrink-0 bg-accent" />
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
                <div class="mt-3 flex flex-wrap gap-1.5">
                  {job.stack.map((tech) => (
                    <span class="rounded border border-line bg-panel-2 px-1.5 py-0.5 font-mono text-[10px] text-faint">
                      {tech}
                    </span>
                  ))}
                </div>
              </>
            )}
          </div>
        </li>
      );
    })}
</ol>
