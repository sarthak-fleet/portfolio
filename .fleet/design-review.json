{
  "$schema": "fleet.design-review.v1",
  "version": 1,
  "project": "portfolio",
  "target": "IssuePages notes publication on the blog",
  "mode": "preserve",
  "register": "product",
  "context": {
    "product": "PROJECT_STATUS.md",
    "design": "src/styles/global.css"
  },
  "direction": {
    "references": [],
    "probes": [],
