{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "extends": [
    "ultracite/biome/react",
    "ultracite/biome/astro",
    "ultracite/biome/core"
  ],
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false,
    "actions": {
      "source": {
        "useSortedPackageJson": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "enabled": false
    }
  },
  "json": {
    "formatter": {
      "enabled": false
    }
  },
  "css": {
    "formatter": {
      "enabled": false
    },
    "parser": {
      "tailwindDirectives": true
    }
  },
  "html": {
    "formatter": {
      "enabled": false
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/.astro",
      "!!**/dist",
      "!!**/public",
      "!!**/coverage",
      "!!**/package-lock.json"
    ]
  },
  "linter": {
    "rules": {
      "a11y": {
        "noNoninteractiveElementInteractions": "off",
        "noStaticElementInteractions": "off",
        "noSvgWithoutTitle": "off",
        "useKeyWithClickEvents": "off",
        "useSemanticElements": "off"
      },
      "complexity": {
        "noDivRegex": "off",
        "noExcessiveCognitiveComplexity": "off",
        "noForEach": "off",
        "noVoid": "off",
        "useRegexLiterals": "off",
        "useSimplifiedLogicExpression": "off"
      },
      "correctness": {
        "useExhaustiveDependencies": "off",
        "useJsxKeyInIterable": "off"
      },
      "nursery": {
        "useSortedClasses": "off"
      },
      "performance": {
        "noAwaitInLoops": "off",
        "noJsxPropsBind": "off",
        "useTopLevelRegex": "off"
      },
      "style": {
        "noIncrementDecrement": "off",
        "noNestedTernary": "off",
        "useBlockStatements": "off",
        "useConsistentTypeDefinitions": "off",
        "useFilenamingConvention": "off"
      },
      "suspicious": {
        "noAlert": "off",
        "noArrayIndexKey": "off",
        "noBiomeFirstException": "off",
        "noCommentText": "off",
        "noEmptyBlockStatements": "off",
        "noEvolvingTypes": "off",
        "noLeakedRender": "off",
        "noShadow": "off",
        "noUnknownAttribute": "off",
        "useAwait": "off",
        "useIterableCallbackReturn": "off"
      }
    }
  }
}
